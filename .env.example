# Copy to .env, then paste your Neon pooled connection string.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR-ENDPOINT-pooler.region.aws.neon.tech/DATABASE?ssl=require
REDIS_PORT=6379
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3.2
EMBEDDING_MODEL_NAME=nomic-embed-text
DB_BOOTSTRAP_ON_STARTUP=false
DB_ECHO=false
RAG_MIN_SCORE=0.50